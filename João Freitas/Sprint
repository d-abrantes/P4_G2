    #include <stdio.h>

int main(void) {
    int x;
    printf("Qual é o valor?");
    scanf("%d", &x);
    if (0 <= x && x <= 1023) { 
        printf("Valor válido\n");}
    float temp = 260.0 * x / 1023 - 20;
    if (-10 <= temp && temp <= 190) {
        printf("Valor: %.2fºC\n", temp);
    }
    else {
        printf("Valor fora da gama\n");
    }
}
